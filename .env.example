# --- PayPal (developer.paypal.com > Apps & Credentials > Sandbox > your app) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Webhook ID from the same app's Webhooks section (needed for live "paid" events on a public URL)
PAYPAL_WEBHOOK_ID=
# Shown as the sender on invoices (optional)
INVOICER_BUSINESS_NAME=
# Set to true to run with an in-memory fake PayPal (no credentials needed)
PAYPAL_MOCK=false

# --- Cerebras (cloud.cerebras.ai > API Keys) ---
CEREBRAS_API_KEY=
# qwen-3.8-27b reads screenshots; gpt-oss-120b is cheaper but text-only
CEREBRAS_MODEL=qwen-3.8-27b
# none | low | medium | high
CEREBRAS_REASONING_EFFORT=low

PORT=3000
